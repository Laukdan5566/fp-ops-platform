      "content_patterns": [
        "*BORPLAST_DADOS*",
        "*BORPLAST DADOS*"
      ],
      "exclude_patterns": []
    },
    {
      "servidor_log": "BORPLAST_VV",
      "log_paths": [
        "C:\\ProgramData\\IperiusBackup\\Logs"
      ],
      "patterns": [
        "*.txt",
        "*.log",
        "*.html",
        "*.htm"
      ],
      "include_patterns": [
        "*VV*"
      ],
      "content_patterns": [
        "*BORPLAST_VV*",
        "*BORPLAST VV*"
      ],
      "exclude_patterns": []
